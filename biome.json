{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"recommended": true,
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							{ "type": false, "source": [":PACKAGE:", ":NODE:"] },
							":BLANK_LINE:",
							{ "type": false, "source": [":ALIAS:", ":PATH:"] },
							":BLANK_LINE:",
							{ "type": true, "source": [":PACKAGE:", ":PATH:"] }
						]
					}
				}
			}
		}
	},
	"linter": {
		"enabled": true,
		"domains": {
			"test": "recommended"
		},
		"rules": {
			"recommended": true,
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": {
						"maxAllowedComplexity": 15
					}
				}
			},
			"correctness": {
				"noUnusedFunctionParameters": "error",
				"noUnusedImports": "error",
				"noUnusedPrivateClassMembers": "error",
				"noUnusedVariables": "error"
			},
			"performance": {
				"noReExportAll": "error"
			},
			"style": {
				"noNonNullAssertion": "error",
				"useExportType": "error",
				"useImportType": "error",
				"useNodejsImportProtocol": "error"
			},
			"suspicious": {
				"noConsole": "error",
				"noDebugger": "error",
				"noEmptyBlockStatements": "error",
				"noExplicitAny": "error",
				"noFocusedTests": "error",
				"noSkippedTests": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["scripts/**", "bin/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "asNeeded"
		},
		"globals": ["React"]
	}
}
