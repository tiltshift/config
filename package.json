{
	"name": "@tiltshift/config",
	"version": "5.0.0",
	"repository": "https://github.com/tiltshift/config.git",
	"author": "Chris Drackett",
	"license": "MIT",
	"files": [
		"biome.json",
		"codebook.toml",
		"tsconfig.base.json"
	],
	"exports": {
		"./biome": "./biome.json",
		"./codebook": "./codebook.toml",
		"./tsconfig": "./tsconfig.base.json"
	},
	"type": "module",
	"dependencies": {
		"@biomejs/biome": "2.5.13",
		"typescript": "7.0.2"
	},
	"packageManager": "yarn@4.18.0",
	"volta": {
		"node": "24.21.0",
		"yarn": "4.18.0"
	},
	"scripts": {
		"check": "biome check --config-path=biome.json",
		"lint": "biome check --fix --config-path=biome.json",
		"dry-run": "bash scripts/dry-run.sh",
		"test": "bash scripts/dry-run.test.sh"
	}
}
